{
  "name": "github-action-jira-issues-fixversion-manager",
  "version": "1.0.6",
  "description": "This action will find the issue keys in the GitHub event and return them as a comma separated list",
  "main": "dist/index.js",
  "sideEffects": false,
  "displayName": "bitflight-devops/github-action-jira-issues-fixversion-manager",
  "repository": {
    "type": "git",
    "url": "git@github.com:bitflight-devops/github-action-jira-issues-fixversion-manager.git"
  },
  "bugs": {
    "url": "https://github.com/bitflight-devops/github-action-jira-issues-fixversion-manager/issues"
  },
  "keywords": [
    "actions",
    "github",
    "node22",
    "jira",
    "tickets"
  ],
  "author": "Jamie Nelson <jamie@bitflight.io>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "NODE_ENV=testing vitest run",
    "test:watch": "NODE_ENV=testing vitest",
    "test:unit": "NODE_ENV=testing vitest run --testNamePattern='sets defaults|handles missing'",
    "test:integration": "NODE_ENV=testing vitest run --testNamePattern='GitHub Event'",
    "test-ci": "NODE_ENV=testing vitest run --reporter=default --reporter=junit --outputFile=junit.xml",
    "build": "rimraf dist && yarn package",
    "package": "rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:markdown": "markdownlint \"**/*.md\" --config=.markdownlint.json --ignore-path=.markdownlintignore",
    "lint:markdown:fix": "yarn lint:markdown --fix",
    "all": "yarn run build && yarn run format && yarn run lint && yarn run package && yarn test",
    "commit": "git-cz",
    "pre-commit": "lint-staged && yarn run build && git add dist && yarn run generate-docs",
    "pre-push": "echo 'Running pre-push checks'; exit 0",
    "preversion": "echo 'Running test';yarn test",
    "version": "yarn generate-docs",
    "postversion": "echo 'Running post versioning commands';echo \"Prepared release version $npm_package_version\"",
    "generate-docs": "github-action-readme-generator && biome format --write .ghadocs.json README.md && git add .ghadocs.json README.md",
    "prepare": "test -n \"$CI\" || husky",
    "e2e:test": "NODE_ENV=testing vitest run --config vitest.e2e.config.ts"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-max-length": [
        0
      ],
      "body-max-line-length": [
        0
      ],
      "footer-max-length": [
        0
      ],
      "footer-max-line-length": [
        0
      ],
      "header-max-length": [
        0
      ]
    }
  },
  "engines": {
    "node": ">=24.19.0 <30.0.0"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist"
  ],
  "dependencies": {
    "@actions/core": "^2.0.2",
    "@actions/github": "^7.0.0",
    "@octokit/rest": "^22.0.1",
    "ansi-colors": "^4.1.3",
    "jira.js": "^5.2.2",
    "tslib": "^2.8.1",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.12",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@commitlint/prompt": "^17.1.2",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@swc/core": "^1.3.11",
    "@tsconfig/node22": "^22.0.5",
    "@types/js-yaml": "^4.0.5",
    "@types/lodash": "^4.14.186",
    "@types/node": "^25.0.9",
    "@vitest/coverage-v8": "^4.0.18",
    "commitizen": "^4.2.5",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^17.2.3",
    "github-action-readme-generator": "1.2.7",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.0",
    "lint-staged": "^16.2.7",
    "markdownlint-cli": "^0.32.2",
    "rimraf": "^6.1.2",
    "rollup": "^4.56.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "yarn-or-npm": "^3.0.1"
  },
  "lint-staged": {
    "*.{ts,js,tsx,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "optionalDependencies": {
    "@swc/core-darwin-x64": "^1.3.11"
  },
  "packageManager": "yarn@1.22.22"
}
